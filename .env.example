# ---- Upstream N-ATLAS (any OpenAI-compatible server) ----
# Local mock (npm run mock):           http://127.0.0.1:9090/v1
# vLLM serving NCAIR1/N-ATLaS:         http://<gpu-host>:8000/v1
# Ollama:                              http://127.0.0.1:11434/v1
# Featherless / HF Inference Endpoint: https://<provider>/v1
UPSTREAM_URL=http://127.0.0.1:9090/v1
UPSTREAM_API_KEY=
UPSTREAM_MODEL=n-atlas-8b
UPSTREAM_TIMEOUT_MS=60000

PORT=8080
# Optional: share cache, rate limits and budgets across replicas.
REDIS_URL=

# ---- Cache ----
CACHE_ENABLED=true
SEMANTIC_CACHE=true
SEMANTIC_THRESHOLD=0.86
CACHE_TTL_SECONDS=86400
MAX_CACHEABLE_TEMPERATURE=0.8

# ---- Security ----
INJECTION_MODE=block          # block | flag
INJECTION_THRESHOLD=0.7
IP_RATE_LIMIT_PER_MINUTE=120
ADMIN_TOKEN=                  # set in production to protect /admin/audit and /admin/tenants
PSEUDONYM_SECRET=change-me-to-a-long-random-string
ALLOW_ANONYMOUS=false
# Demo tenants (key and key + "-zr" for zero-retention). Set empty to disable in production.
DEMO_API_KEY=sk-natlas-demo-key
